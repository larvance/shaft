{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shaft",
  "version": "0.1.0",
  "identifier": "com.larvance.shaft",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shaft",
        "url": "index.html",
        "width": 940,
        "height": 660,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "devtools": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  }
}
